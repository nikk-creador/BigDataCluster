# Kafka broker and Wikimedia EventStreams topic.
KAFKA_ADVERTISED_HOST=localhost
KAFKA_SPARK_ADVERTISED_HOST=kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SPARK_KAFKA_BOOTSTRAP_SERVERS=kafka:9095
WIKIMEDIA_KAFKA_TOPIC=wikimedia.recentchange.v1
WIKIMEDIA_KAFKA_GROUP=wikimedia-dashboard-sqlite-v1
WIKIMEDIA_DB=wikimedia_live.db
WIKIMEDIA_USER_AGENT=BigDataClusterLiveEdits/1.0 (educational real-time analytics project)

# Set these to the master's stable LAN IP to accept remote Spark workers.
SPARK_CLUSTER_PUBLIC_HOST=spark-analytics

# SPARK_KAFKA_BOOTSTRAP_SERVERS should be the broker address reachable by all workers.
